# ============================================================================
# OurVenture — Environment variables
# Copy this file to .env.local and fill in real values for local development.
# NEVER commit .env.local.
# ============================================================================

# ---- Supabase (Auth + DB + Storage) ----------------------------------------
# Found at: Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only; never expose to the browser. Used for admin/cron tasks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Drizzle / Postgres ----------------------------------------------------
# Found at: Supabase Project Settings → Database → Connection string (URI).
# Use the *pooler* connection string (port 6543) for Vercel; use the *direct*
# string (port 5432) for drizzle-kit migrations.
DATABASE_URL=postgresql://postgres:password@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# ---- Mapbox (map rendering) ------------------------------------------------
# Public token, scoped to your domains. Free tier covers <50K loads/mo.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token

# ---- Google Places API (New) ----------------------------------------------
# Server-side only. Used for place search + hours/photos.
GOOGLE_PLACES_API_KEY=your-google-places-key

# ---- Resend (transactional email) ------------------------------------------
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=OurVenture <hello@yourdomain.com>

# ---- App config -----------------------------------------------------------
# Used to build invite links, OAuth callback URLs, recap share links, etc.
# Local dev: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
